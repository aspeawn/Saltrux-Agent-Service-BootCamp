<?xml version="1.0" encoding="UTF-8" ?>

<!--
logback 파일을 만들면 기본적으로 사용하던 spring 내장된 logback이 동작하지 않는다.
-> xml파일에 설정한 형태로만 동작함

- logback.xml           : 스프링보다 먼저 읽혀서 스프링의 설정을 쓸 수 없음(yaml)
- logback-spring.xml    : 스프링이 파일을 읽어서 넘겨주므로 yaml 파일 설정을 쓸 수 있음

===> logback-spring에 작성하는 내용 : 어디에, 어떤 모양으로 로그를 작성할 것인가.
===> yaml에 작성하는 내용           : 어느 레벨까지 남길 것 인가 (로그레벨)
-->

<configuration>
    <!-- 스프링 부트에서 지정한 기본값 가지고오기 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- 스프링의 기본 로그 모양을 그대로 사용 -->
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
   %d{yyyy-MM-dd HH:mm:ss.SSS} : 날짜와 시각. 순서를 따질 수 있게 1000분의 1초까지 남긴다.
   %-5level                    : 로그 레벨. 5칸으로 맞춰서 세로줄이 가지런해진다.
   [%X{traceId:-}]             : 요청 번호. TraceIdFilter 가 MDC 에 넣어 둔 값이다. 없으면 빈칸.
   %logger{36}                 : 로그를 남긴 클래스. 36자를 넘으면 패키지 이름을 줄여서 쓴다.
   %msg%n                      : 로그 메시지와 줄바꿈.
    -->
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{traceId:-}] %logger{36} - %msg%n"/>
    <!--
    File Rolling (파일회전)
    - maxFileSize   : 날짜가 바뀌거나 이 크기를 넘으면
    - maxHistory    : 얼마나 보관할 지
    - totalSizeCap  : 최대로 보관할 용량 (넘으면 오래된것부터 지우기)
    -->
    <!-- 파일 출력 어펜더 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/study-board.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 넘어간 파일이름.날짜(%d), 순번(%i) -->
            <fileNamePattern>logs/study-board.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10KB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>

        <encoder>
            <!-- 스프링의 기본 로그 모양을 그대로 사용 -->
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--  에러 파일 출력 어펜더  -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/study-board-error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 에러 파일은 일반 로그와 다른 이름 규칙을 사용 -->
            <fileNamePattern>logs/study-board-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10KB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <!-- 스프링의 기본 로그 모양을 그대로 사용 -->
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
    어떤 appender로 로그를 내보낼지 정하는 곳
    - 이 위치에 등록한 appender만 실제로 동작
    - 여기서 정한 level이 기본 레벨이 되고, 패키지 단위의 레벨은 yaml파일에서 정한 값이 우선된다.
    -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>
